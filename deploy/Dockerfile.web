# The bundle is built by the workflow, not here: Vite inlines the ZenMoney
# credentials and the redirect URI at build time, so every environment gets its
# own image. This stage only wraps an already-built `dist/`.
ARG APP_VERSION=dev
ARG BUILD_DATE=unknown

FROM nginxinc/nginx-unprivileged:1.28.1-alpine AS runtime

ARG APP_VERSION
ARG BUILD_DATE

LABEL org.opencontainers.image.version=$APP_VERSION \
      org.opencontainers.image.created=$BUILD_DATE

COPY deploy/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY dist/ /usr/share/nginx/html/

USER root
RUN printf '{"version":"%s","buildDate":"%s"}\n' "$APP_VERSION" "$BUILD_DATE" \
      > /usr/share/nginx/html/version.json \
    && chown -R 101:101 /usr/share/nginx/html \
    && grep -F "\"version\":\"$APP_VERSION\"" /usr/share/nginx/html/version.json
USER 101

EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=6 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
