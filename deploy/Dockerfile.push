# Zerno's push alarm clock: no dependencies, just Node and two files.
ARG APP_VERSION=dev
ARG BUILD_DATE=unknown

FROM node:24-alpine

ARG APP_VERSION
ARG BUILD_DATE

LABEL org.opencontainers.image.version=$APP_VERSION \
      org.opencontainers.image.created=$BUILD_DATE

WORKDIR /app
COPY deploy/push/lib.mjs deploy/push/server.mjs ./

# Created here so a fresh named volume inherits the owner.
RUN mkdir /data && chown node:node /data
VOLUME /data
USER node

ENV NODE_ENV=production PORT=8080 DATA_DIR=/data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/push/health || exit 1
CMD ["node", "server.mjs"]
